# ============================================================
# 复制本文件为 .env 后填写真实密钥：cp .env.example .env
# .env 已被 .gitignore 排除，请勿提交到仓库
# ============================================================

# ---------------- 对话模型（OpenAI 兼容，靠 base_url 区分供应商）----------------
# deepseek 调真实接口 / mock 用检索片段拼模板回答（配合 EMBED_PROVIDER=mock 可完全离线跑通）
LLM_PROVIDER=deepseek
# API Key，从供应商控制台获取，形如 sk-xxxxxxxx
LLM_API_KEY=sk-请替换为你的密钥
# 兼容端点。官方 DeepSeek 用 https://api.deepseek.com；
# 公司中转站必须带 /v1（不带会 404），如 https://ai.ouflow.cn/v1
LLM_BASE_URL=https://api.deepseek.com
# 对话模型名。注意官方端点用 deepseek-chat；公司中转站无此模型名，实测用 deepseek-v4-flash
LLM_MODEL=deepseek-chat
# 生成温度：0 更稳定严谨，适合知识库问答；调高更发散
LLM_TEMPERATURE=0.2
# 单次回答最大生成 token 数。非推理模型（deepseek-chat 等）2048 已够，这里给 8192 留余量。
# ⚠️ 推理型模型（如公司中转站的 deepseek-v4-flash）的思考过程也计入此处，且思考量随
#    检索上下文变长而暴涨（实测带上下文达 1367~9040，且随上下文长度上升），
#    给到 8192 仍可能 finish_reason=length 且正文为空 —— 此时应调到 ≥16384。
# 注：max_tokens 是上限而非预扣，给大不会额外花钱。
LLM_MAX_TOKENS=8192
# 自定义 User-Agent，留空表示不附加任何模拟头。
# ⚠️ 仅当公司中转站按客户端身份白名单放行、普通客户端被 403 拒绝时才需要填。
#    填了等于伪装成白名单里的客户端，构成绕过公司访问控制，启用前务必确认合规。
#    详见 README「接入公司中转站」一节。
LLM_USER_AGENT=
# 拼进 prompt 的上下文正文字符上限，超出按检索排名截断
CONTEXT_MAX_CHARS=6000

# ---------------- 向量模型（硅基流动 SiliconFlow，OpenAI 兼容）----------------
# 向量供应商：siliconflow（调真实接口）/ mock（离线假向量，不联网）
EMBED_PROVIDER=siliconflow
# 硅基流动 API Key，形如 sk-xxxxxxxx
EMBED_API_KEY=sk-请替换为你的密钥
# 硅基流动兼容端点（必须带 /v1）
EMBED_BASE_URL=https://api.siliconflow.cn/v1
# 向量模型名
EMBED_MODEL=BAAI/bge-m3
# 向量维度，必须与模型输出一致，否则写入 ChromaDB 会报错
EMBED_DIM=1024

# ---------------- 向量库 ChromaDB ----------------
# 本地持久化目录（相对项目根目录），首次运行自动创建
CHROMA_DIR=chroma_db
# 集合名称，同一份数据换集合名等于换一个独立知识库
CHROMA_COLLECTION=future_community_kb

# ---------------- 中文分块参数 ----------------
# 单块最大字符数（中文按字符计，500 约等于一个完整小节）
CHUNK_SIZE=500
# 相邻块重叠字符数，防止答案被切断在块边界，一般取 CHUNK_SIZE 的 10%~20%
CHUNK_OVERLAP=80
# 少于该字符数的碎块直接丢弃（多为页眉页脚残渣）
CHUNK_MIN_LENGTH=30

# ---------------- 检索参数 ----------------
# 召回条数：送给大模型作上下文的片段数量
TOP_K=5
# 相似度下限（0~1，越大越严格），低于该值的片段不送模型；针对真实向量模型
SCORE_THRESHOLD=0.3
# mock 向量模式的相似度下限。哈希词袋的量级远低于真实模型，必须单列，否则离线时检索为空
SCORE_THRESHOLD_MOCK=0.02

# ---------------- 筛选：脱敏 ----------------
# 自定义敏感词/内部人名，逗号分隔；正则无法覆盖的（如真实业主姓名）写这里
SENSITIVE_WORDS=内部示例公司,张三,李四
# 脱敏后用于替换的占位符
MASK_TOKEN=【已脱敏】
# 是否脱敏金额：合同金额敏感，但行业标准里的限额数字是知识本体，按语料性质决定
MASK_AMOUNT=false

# ---------------- 筛选：去重 ----------------
# 文本相似度（3-gram Jaccard）高于该阈值判为重复，只保留一条（0~1）。
# 0.9 可覆盖「只改姓名/手机号的案例复制件」（实测约 0.92）；调到 0.95 会漏掉这类
DEDUP_SIMILARITY_THRESHOLD=0.9

# ---------------- 服务端口 ----------------
API_HOST=0.0.0.0
API_PORT=8000
